# Copy to .env.local and fill in. Never prefix server secrets with VITE_
# (anything VITE_* is bundled into the browser).

# Neon Postgres connection string (Neon console → Connect). Used by the api/
# functions, `pnpm dev`, and the db:* scripts. On Vercel, set it under
# Project → Settings → Environment Variables (or via the Neon integration).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Groq API key for the AI chat (console.groq.com/keys). Server-only.
GROQ_API_KEY=gsk_...
# Optional: override the model (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
